{
  "name": "clinica-implavita",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site institucional da Clinica Implavita Implantes - Patos de Minas/MG",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx watch server/src/index.ts",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "node server/dist/server/src/index.js",
    "db:migrar": "tsx server/src/db/migrar.ts",
    "db:semear": "tsx server/src/db/semear.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "lucide-react": "0.468.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
