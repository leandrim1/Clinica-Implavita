# --- Banco de dados ---
# Em produção use a connection string do Neon (ou outro Postgres gerenciado).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/implavita
# Exigido pelo Neon e pela maioria dos provedores gerenciados.
DATABASE_SSL=false

# --- Servidor ---
# Evite NODE_ENV aqui: o Vite lê este arquivo no build e passaria a
# empacotar a versão de desenvolvimento do React.
PORT=3333
AMBIENTE=development
# Origens autorizadas a chamar a API, separadas por vírgula.
ORIGENS_PERMITIDAS=http://localhost:5173,http://localhost:4173

# --- Sessão ---
# Segredo usado para assinar os identificadores de sessão.
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SEGREDO_SESSAO=troque-este-valor-em-producao
# Duração da sessão em horas.
SESSAO_HORAS=12

# --- Primeiro acesso ---
# O administrador NÃO é criado por aqui, de propósito: senha em texto
# puro num arquivo de configuração vaza fácil. Crie a conta com:
#   npm run db:admin

# --- Armazenamento de imagens ---
# 'local' grava em public/midia/enviados. 'blob' usa o Vercel Blob.
ARMAZENAMENTO=local
BLOB_READ_WRITE_TOKEN=

# --- Integrações opcionais ---
# Avaliações ao vivo do Google. Sem a chave, o site usa os números salvos.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJswQVCSmLrpQRgtx3q7MRGNU
